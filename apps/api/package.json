{
  "name": "@leados/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "ROLE=worker LOG_LEVEL=debug node --watch --import @swc-node/register/esm-register src/main.ts",
    "dev:scheduler": "ROLE=scheduler node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --exclude '**/*.int-spec.ts' --exclude '**/*.e2e-spec.ts'",
    "test:int": "vitest run int-spec e2e-spec"
  },
  "dependencies": {
    "@leados/db": "workspace:*",
    "@leados/shared": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@types/pdfkit": "^0.17.6",
    "bullmq": "^6.3.9",
    "dejavu-fonts-ttf": "^2.37.3",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.10.9",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
