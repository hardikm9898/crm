# ─────────────────────────────────────────────────────────────────────────────
# Lead OS — local environment template.  Copy to .env and adjust.
# Every variable here is validated at boot (apps/api/src/infra/config).
# The process refuses to start if one is missing or malformed — see
# docs/security.md §9 and docs/deployment-architecture.md §1.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# Process role: api | collector | worker | scheduler  (docs/system-architecture.md §2)
ROLE=api
PORT=4000

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://leados:leados@localhost:5432/leados
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ── Auth (Phase 1 step 2) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Credential vault (docs/integration-architecture.md §5) ───────────────────
# 32 raw bytes, base64-encoded: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA=

# ── Object storage (S3-compatible; MinIO locally) ────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=leados-dev
S3_ACCESS_KEY_ID=leadosdev
S3_SECRET_ACCESS_KEY=leadosdev
S3_FORCE_PATH_STYLE=true

# ── Web client ───────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Integration tests run against a separate database so they can never touch dev data.
DATABASE_URL_TEST=postgresql://leados:leados@localhost:5432/leados_test
