{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "REDIS_URL",
    "DATABASE_URL_TEST",
    "REDIS_URL_TEST",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "ENCRYPTION_MASTER_KEY",
    "WEB_REVALIDATE_SECRET",
    "WEB_ORIGIN",
    "WEBSITE_BASE_DOMAIN",
    "META_GRAPH_URL",
    "TEST_LOG_LEVEL"
  ],
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "@leados/db#generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "@leados/db#generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["@leados/db#generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "@leados/db#generate"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build", "@leados/db#generate"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "dependsOn": ["^build", "@leados/db#generate"],
      "cache": false
    }
  }
}
