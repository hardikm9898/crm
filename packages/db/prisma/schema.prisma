// ─────────────────────────────────────────────────────────────────────────────
// Lead OS — Phase 1 schema: platform, organization, identity, access, audit,
// outbox and subscription. CRM entities (leads, tasks, conversations, ...) arrive
// in Phase 2. Conventions and rationale: docs/database-design.md §1.
//
// Two rules govern every tenant table here:
//   1. `organization_id` is NOT NULL and leads every index.
//   2. Children reference parents with a COMPOSITE foreign key that includes
//      `organization_id`, so a row can never point at another tenant's row.
//      That is isolation layer 3 (docs/security.md §3) — it turns an application
//      bug into a foreign-key error instead of a data breach.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums: developer-owned values that code branches on. ─────────────────────
// Anything a tenant can rename or extend (statuses, sources, task types, ...)
// is a TABLE, never an enum — Rules 5-8 in docs/README.md.

enum OrganizationStatus {
  trialing
  active
  past_due
  grace
  suspended
  cancelled

  @@map("organization_status")
}

enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  grace
  cancelled
  expired

  @@map("subscription_status")
}

enum PlanInterval {
  month
  year

  @@map("plan_interval")
}

enum FeatureUnit {
  bool
  count
  per_month
  bytes

  @@map("feature_unit")
}

enum DataScope {
  own
  team
  branch
  organization

  @@map("data_scope")
}

enum ActorType {
  user
  system
  automation
  api_key
  platform

  @@map("actor_type")
}

enum NotificationChannel {
  in_app
  email
  whatsapp
  push

  @@map("notification_channel")
}

enum AvailabilityState {
  available
  busy
  leave
  offline

  @@map("availability_state")
}

/// What a duplicate rule does when it matches (`FR-DUP-2`).
enum DuplicateAction {
  /// The default, and the one that preserves attribution: no new lead, a touchpoint on the existing.
  attach_to_existing
  /// Create the lead but link it, so a human decides.
  create_and_link
  /// Refuse the capture outright. For rules a business is certain about.
  reject
  /// Matched, but deliberately allowed through.
  create_new

  @@map("duplicate_action")
}

enum DuplicateStatus {
  open
  merged
  dismissed

  @@map("duplicate_status")
}

/// How an assignment rule picks someone (`FR-ASG-3`).
enum AssignmentStrategy {
  specific_user
  team
  round_robin
  weighted_round_robin
  least_open_leads
  top_performer

  @@map("assignment_strategy")
}

enum LeadStatusCategory {
  open
  won
  lost
  invalid

  @@map("lead_status_category")
}

enum LeadPriority {
  low
  medium
  high
  urgent

  @@map("lead_priority")
}

/// How a lead entered the system. Used for attribution and for "who typed this in".
enum LeadCreatedVia {
  manual
  form
  api
  webhook
  import
  whatsapp
  meta_ads
  google_ads
  website

  @@map("lead_created_via")
}

enum PipelineEntity {
  lead
  deal

  @@map("pipeline_entity")
}

enum CustomFieldEntity {
  lead
  customer
  deal
  task
  conversation

  @@map("custom_field_entity")
}

/// The stored shape of a custom field's value is decided by this type; the registry in
/// `@leados/shared` (`CUSTOM_FIELD_SPECS`) is the single description of what each one accepts.
enum CustomFieldType {
  text
  textarea
  number
  decimal
  currency
  boolean
  date
  datetime
  select
  multiselect
  radio
  checkbox_group
  email
  phone
  url
  rating
  file

  @@map("custom_field_type")
}

enum ActivityVisibility {
  all
  internal

  @@map("activity_visibility")
}

/// Where a touchpoint came from. A lead can accumulate many, and they are never overwritten.
enum TouchpointChannel {
  website
  form
  whatsapp
  call
  email
  meta_ads
  google_ads
  referral
  walk_in
  marketplace
  import
  manual
  api
  other

  @@map("touchpoint_channel")
}

// ═════════════════════════════════════════════════════════════════════════════
// PLATFORM TABLES — no organization_id, unreachable from tenant routes.
// ═════════════════════════════════════════════════════════════════════════════

model Plan {
  id            String         @id @db.Uuid
  code          String         @unique
  name          String
  description   String?
  interval      PlanInterval
  priceMinor    BigInt         @map("price_minor")
  currency      String         @db.Char(3)
  trialDays     Int            @default(7) @map("trial_days")
  isPublic      Boolean        @default(true) @map("is_public")
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Catalogue of entitlement keys. Super Admin editable, never hardcoded (FR-BIL-2).
model Feature {
  key         String        @id
  name        String
  description String?
  unit        FeatureUnit
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  plans       PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key")
  /// NULL means unlimited.
  limitValue BigInt? @map("limit_value")
  isEnabled  Boolean @default(true) @map("is_enabled")
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

model PlatformSetting {
  key       String   @id
  value     Json     @db.JsonB
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Our own staff. A separate auth realm from tenant users: no tenant token can
/// ever resolve to a platform user (docs/security.md §4).
model PlatformUser {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  isSuperAdmin Boolean    @default(false) @map("is_super_admin")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_users")
}

/// Permission catalogue. Code checks permission keys, never role names (FR-IAM-3).
model Permission {
  key           String           @id
  module        String
  description   String
  supportsScope Boolean          @default(true) @map("supports_scope")
  grants        RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Global identity. Credentials live here so one person can belong to several
/// organizations (FR-IAM-6); org-specific state lives on `memberships`.
model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  name               String
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  phoneE164          String?    @map("phone_e164") @db.VarChar(20)
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(invited)
  timezone           String?
  locale             String?    @default("en")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  /// AES-256-GCM ciphertext, never the raw TOTP secret (docs/security.md §9).
  mfaSecretEncrypted String?    @map("mfa_secret_encrypted")
  mfaEnrolledAt      DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(6)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships        Membership[]
  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  mfaRecoveryCodes   MfaRecoveryCode[]

  @@index([status])
  @@map("users")
}

/// Refresh-token family. Rotation with reuse detection: presenting a rotated
/// token revokes the whole family (FR-IAM-2, docs/security.md §2).
model Session {
  id                   String    @id @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  familyId             String    @map("family_id") @db.Uuid
  previousSessionId    String?   @map("previous_session_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address")
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?   @map("revoked_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Dead-letter mirror for jobs that exhausted their retries.
///
/// BullMQ already keeps failed jobs in Redis; this table is what makes them visible to an
/// operator instead of to redis-cli (FR-SA-4). Payloads are redacted before storage, because a
/// failure table is exactly where a customer's phone number or a single-use token would linger.
model JobFailure {
  id        String    @id @db.Uuid
  queue     String
  jobName   String    @map("job_name")
  jobId     String?   @map("job_id")
  payload   Json      @db.JsonB
  error     String
  stack     String?
  attempts  Int       @default(0)
  retriedAt DateTime? @map("retried_at") @db.Timestamptz(6)
  retriedBy String?   @map("retried_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queue, createdAt(sort: Desc)])
  @@index([retriedAt])
  @@map("job_failures")
}

/// Heartbeat for the scheduler process, so "the schedule stopped running" is detectable rather
/// than only noticed when something that should have happened did not
/// (docs/deployment-architecture.md §7).
model SchedulerHeartbeat {
  id         String   @id @db.Uuid
  instanceId String   @unique @map("instance_id")
  lastBeatAt DateTime @map("last_beat_at") @db.Timestamptz(6)
  registered Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lastBeatAt])
  @@map("scheduler_heartbeats")
}

/// Single-use, hashed password-reset tokens. The plaintext token exists only in the
/// email we send; only its hash is stored, so a database read cannot reset anyone's
/// password (docs/security.md §2).
model PasswordReset {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  requestedIp String?   @map("requested_ip")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// Email ownership proof. Carries the address being verified, so changing an email
/// cannot be confirmed by a token issued for the previous one.
model EmailVerification {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, verifiedAt])
  @@map("email_verifications")
}

/// One-time codes that let a user back in when they lose their authenticator.
/// Hashed like passwords, and consumed on use.
model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

// ═════════════════════════════════════════════════════════════════════════════
// TENANT TABLES — every row carries organization_id.
// ═════════════════════════════════════════════════════════════════════════════

model Organization {
  id                  String             @id @db.Uuid
  slug                String             @unique
  name                String
  legalName           String?            @map("legal_name")
  industry            String?
  country             String             @default("IN") @db.Char(2)
  timezone            String             @default("Asia/Kolkata")
  defaultCurrency     String             @default("INR") @map("default_currency") @db.Char(3)
  defaultPhoneCountry String             @default("IN") @map("default_phone_country") @db.Char(2)
  status              OrganizationStatus @default(trialing)
  /// Tenant identifier used by the public ingestion API (docs/api-architecture.md §6).
  publicKey           String             @unique @map("public_key")
  logoUrl             String?            @map("logo_url")
  settings            Json               @default("{}") @db.JsonB
  onboardingState     Json               @default("{}") @map("onboarding_state") @db.JsonB
  suspendedAt         DateTime?          @map("suspended_at") @db.Timestamptz(6)
  suspendedReason     String?            @map("suspended_reason")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  branches                Branch[]
  teams                   Team[]
  teamMembers             TeamMember[]
  memberships             Membership[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  outboxEvents            OutboxEvent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  subscription            Subscription?
  usageCounters           UsageCounter[]
  entitlementOverrides    EntitlementOverride[]
  workingHours            WorkingHours[]
  holidays                Holiday[]
  availability            UserAvailability[]

  // Phase 2 — CRM core
  customFieldSections      CustomFieldSection[]
  customFieldDefinitions   CustomFieldDefinition[]
  customFieldOptions       CustomFieldOption[]
  leadStatuses             LeadStatus[]
  leadSources              LeadSource[]
  lostReasons              LostReason[]
  tags                     Tag[]
  leadTags                 LeadTag[]
  pipelines                Pipeline[]
  pipelineStages           PipelineStage[]
  leads                    Lead[]
  leadTouchpoints          LeadTouchpoint[]
  leadAssignments          LeadAssignment[]
  leadStatusHistory        LeadStatusHistory[]
  leadStageHistory         LeadStageHistory[]
  activities               Activity[]
  duplicateRules           DuplicateRule[]
  leadDuplicates           LeadDuplicate[]
  leadMerges               LeadMerge[]
  assignmentRules          AssignmentRule[]
  assignmentRuleConditions AssignmentRuleCondition[]
  assignmentPoolMembers    AssignmentPoolMember[]
  roundRobinStates         RoundRobinState[]
  scoringRules             ScoringRule[]
  scoreBands               ScoreBand[]
  leadScoreEvents          LeadScoreEvent[]
  savedViews               SavedView[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model Branch {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  code           String?
  addressLine    String?   @map("address_line")
  city           String?
  state          String?
  country        String?   @db.Char(2)
  timezone       String?
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  memberships  Membership[]
  workingHours WorkingHours[]
  holidays     Holiday[]
  leads        Lead[]

  @@unique([organizationId, id], name: "branch_tenant_key")
  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("branches")
}

model Team {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: a team cannot belong to another tenant's branch.
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, map: "teams_branch_same_org_fk")
  members      TeamMember[]
  leads        Lead[]
  savedViews   SavedView[]

  @@unique([organizationId, id], name: "team_tenant_key")
  @@index([organizationId, deletedAt])
  @@map("teams")
}

model TeamMember {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  isLead         Boolean  @default(false) @map("is_lead")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade, map: "team_members_team_same_org_fk")
  // Referencing the MEMBERSHIP (not the global user) is what keeps this tenant-safe:
  // only someone who is a member of this organization can be on one of its teams.
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "team_members_membership_same_org_fk")

  @@unique([organizationId, id], name: "team_member_tenant_key")
  @@unique([organizationId, teamId, userId])
  @@index([organizationId, userId])
  @@map("team_members")
}

/// A user's participation in one organization. The join that makes multi-org
/// membership possible, and the anchor every tenant row uses to reference a person.
model Membership {
  id              String           @id @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(invited)
  defaultBranchId String?          @map("default_branch_id") @db.Uuid
  isOwner         Boolean          @default(false) @map("is_owner")
  invitedById     String?          @map("invited_by_id") @db.Uuid
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBranch           Branch?                  @relation(fields: [organizationId, defaultBranchId], references: [organizationId, id], onDelete: Restrict, map: "memberships_branch_same_org_fk")
  teamMemberships         TeamMember[]
  roles                   UserRole[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  availability            UserAvailability[]
  workingHours            WorkingHours[]
  assignedLeads           Lead[]                   @relation("lead_assignee")
  assignmentPools         AssignmentPoolMember[]
  savedViews              SavedView[]

  @@unique([organizationId, id], name: "membership_tenant_key")
  @@unique([organizationId, userId])
  @@index([organizationId, status, deletedAt])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  /// Seeded roles are marked system: they can be edited but not deleted.
  isSystem       Boolean   @default(false) @map("is_system")
  isEditable     Boolean   @default(true) @map("is_editable")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]
  invitations  Invitation[]
  defaultViews SavedView[]

  @@unique([organizationId, id], name: "role_tenant_key")
  @@unique([organizationId, code])
  @@map("roles")
}

model RolePermission {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  permissionKey  String    @map("permission_key")
  /// How far this grant reaches (FR-IAM-4).
  scope          DataScope @default(own)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, map: "role_permissions_role_same_org_fk")
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([organizationId, roleId, permissionKey])
  @@index([organizationId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "user_roles_membership_same_org_fk")
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, map: "user_roles_role_same_org_fk")

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model Invitation {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  roleId         String           @map("role_id") @db.Uuid
  teamId         String?          @map("team_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, map: "invitations_role_same_org_fk")

  @@unique([organizationId, id], name: "invitation_tenant_key")
  @@index([organizationId, email, status])
  @@index([expiresAt])
  @@map("invitations")
}

// ── Working time: consumed by assignment, SLA clocks and automation delays ───

model WorkingHours {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek      Int      @map("day_of_week") @db.SmallInt
  startMinute    Int      @map("start_minute") @db.SmallInt
  endMinute      Int      @map("end_minute") @db.SmallInt
  isWorking      Boolean  @default(true) @map("is_working")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade, map: "working_hours_branch_same_org_fk")
  membership   Membership?  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "working_hours_membership_same_org_fk")

  @@index([organizationId, userId, dayOfWeek])
  @@index([organizationId, branchId, dayOfWeek])
  @@map("working_hours")
}

model Holiday {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  date           DateTime @db.Date
  name           String
  isWorking      Boolean  @default(false) @map("is_working")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade, map: "holidays_branch_same_org_fk")

  @@unique([organizationId, branchId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

model UserAvailability {
  id             String            @id @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  state          AvailabilityState @default(available)
  fromAt         DateTime?         @map("from_at") @db.Timestamptz(6)
  toAt           DateTime?         @map("to_at") @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "user_availability_membership_same_org_fk")

  @@index([organizationId, userId, fromAt])
  @@map("user_availability")
}

// ── Subscription, entitlements, usage ────────────────────────────────────────

model Subscription {
  id                     String             @id @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(trialing)
  seats                  Int                @default(1)
  startedAt              DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt            DateTime?          @map("grace_ends_at") @db.Timestamptz(6)
  cancelAt               DateTime?          @map("cancel_at") @db.Timestamptz(6)
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  provider               String?
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@unique([organizationId, id], name: "subscription_tenant_key")
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Per-organization deviation from the plan. Sales will promise exceptions;
/// hardcoding them would violate Rule 4, so they are data (FR-BIL-2).
model EntitlementOverride {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  featureKey          String    @map("feature_key")
  limitValue          BigInt?   @map("limit_value")
  isEnabled           Boolean?  @map("is_enabled")
  reason              String
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  setByPlatformUserId String?   @map("set_by_platform_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
  @@map("entitlement_overrides")
}

model UsageCounter {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  metricKey      String    @map("metric_key")
  periodStart    DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime  @map("period_end") @db.Timestamptz(6)
  used           BigInt    @default(0)
  limitSnapshot  BigInt?   @map("limit_snapshot")
  warnedAt       DateTime? @map("warned_at") @db.Timestamptz(6)
  exceededAt     DateTime? @map("exceeded_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricKey, periodStart])
  @@index([organizationId, periodEnd])
  @@map("usage_counters")
}

// ── Notifications ────────────────────────────────────────────────────────────

/// An in-app notification for one user.
///
/// `type` is a string rather than an enum: new notification types arrive with every phase, and a
/// migration per type would be friction for no benefit. The UI renders by type through a registry,
/// exactly as the lead timeline does.
model Notification {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String?
  /// Where clicking it should go, e.g. `/leads/{id}`.
  link           String?
  data           Json      @default("{}") @db.JsonB
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "notifications_membership_same_org_fk")

  /// The unread badge query, and the list query, in one index.
  @@index([organizationId, userId, readAt, createdAt(sort: Desc)])
  @@index([organizationId, type])
  @@map("notifications")
}

/// Per-user, per-type channel preferences (FR-NOT-3).
///
/// Absence of a row means "the default for that type", so a new notification type does not require
/// backfilling a row for every user.
model NotificationPreference {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  type           String
  channels       Json     @default("[]") @db.JsonB
  /// Local time window during which non-urgent notifications are held.
  quietHours     Json?    @map("quiet_hours") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "notification_preferences_membership_same_org_fk")

  @@unique([organizationId, userId, type])
  @@map("notification_preferences")
}

// ── Audit & outbox: infrastructure every later module depends on ─────────────

/// Append-only. The application role has no UPDATE/DELETE grant on this table
/// (see the post-migration hardening SQL) — FR-AUD-2.
model AuditLog {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  actorLabel     String?   @map("actor_label")
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id") @db.Uuid
  before         Json?     @db.JsonB
  after          Json?     @db.JsonB
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  impersonatedBy String?   @map("impersonated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// RESTRICT, not CASCADE: the audit trail must outlive the business data it
  /// describes, and a stray cascade must never wipe it. Purging is a deliberate,
  /// flag-guarded operation — see withAuditPurge() in src/audit-purge.ts.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@map("audit_logs")
}

/// Transactional outbox (ADR-0006). Written inside the business transaction;
/// dispatched afterwards by a worker under withPlatformScope().
model OutboxEvent {
  id             String    @id @db.Uuid
  /// NULL for platform-level events.
  organizationId String?   @map("organization_id") @db.Uuid
  eventId        String    @unique @map("event_id") @db.Uuid
  eventName      String    @map("event_name")
  eventVersion   Int       @default(1) @map("event_version")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json      @db.JsonB
  actorType      ActorType @default(system) @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  correlationId  String?   @map("correlation_id")
  causationId    String?   @map("causation_id")
  causationDepth Int       @default(0) @map("causation_depth")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The dispatcher's hot query: unpublished events, oldest first.
  @@index([publishedAt, occurredAt])
  @@index([organizationId, eventName, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2 — CRM CORE
//
// Everything a tenant can shape is a row: statuses, sources, lost reasons,
// pipelines, stages, tags and custom fields (rule 4). Nothing here is an enum
// a tenant would want to change.
// ═════════════════════════════════════════════════════════════════════════════

/// UI grouping for custom fields. Purely presentational — a field without a section still works.
model CustomFieldSection {
  id                 String            @id @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  entityType         CustomFieldEntity @map("entity_type")
  name               String
  sortOrder          Int               @default(0) @map("sort_order")
  collapsedByDefault Boolean           @default(false) @map("collapsed_by_default")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definitions  CustomFieldDefinition[]

  @@unique([organizationId, id], name: "custom_field_section_tenant_key")
  @@index([organizationId, entityType, sortOrder])
  @@map("custom_field_sections")
}

/// The metadata that makes a custom field exist (ADR-0005). `key` is immutable after creation
/// because it appears in stored JSONB, saved views, import mappings and expression index names —
/// renaming it would silently orphan every value.
model CustomFieldDefinition {
  id             String            @id @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  entityType     CustomFieldEntity @map("entity_type")
  key            String
  label          String
  type           CustomFieldType
  placeholder    String?
  helpText       String?           @map("help_text")
  isRequired     Boolean           @default(false) @map("is_required")
  defaultValue   Json?             @map("default_value") @db.JsonB
  /// Subset of min/max/minLength/maxLength/regex/precision/fileTypes/maxSizeKb, checked against the
  /// type's registry entry so a definition cannot carry a rule its type ignores.
  validation     Json              @default("{}") @db.JsonB
  sectionId      String?           @map("section_id") @db.Uuid
  sortOrder      Int               @default(0) @map("sort_order")
  /// Role and stage conditions deciding when the field is shown; presentation only.
  visibility     Json              @default("{}") @db.JsonB
  showInList     Boolean           @default(false) @map("show_in_list")
  isSearchable   Boolean           @default(false) @map("is_searchable")
  isFilterable   Boolean           @default(true) @map("is_filterable")
  /// True asks for a dedicated expression index. The index is created by a controlled job, and its
  /// name is recorded so deactivation can drop exactly what was created.
  isIndexed      Boolean           @default(false) @map("is_indexed")
  indexName      String?           @map("index_name")
  indexedAt      DateTime?         @map("indexed_at") @db.Timestamptz(6)
  isPii          Boolean           @default(false) @map("is_pii")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  section      CustomFieldSection? @relation(fields: [organizationId, sectionId], references: [organizationId, id], onDelete: Restrict, map: "custom_field_definitions_section_same_org_fk")
  options      CustomFieldOption[]

  @@unique([organizationId, id], name: "custom_field_definition_tenant_key")
  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, isActive, sortOrder])
  @@index([organizationId, isIndexed])
  @@map("custom_field_definitions")
}

/// A choice for a select-like field. `value` is what is stored; `label` is what is shown — so a
/// tenant can rename "Hot" to "Very interested" without rewriting every lead.
model CustomFieldOption {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  definitionId   String   @map("definition_id") @db.Uuid
  value          String
  label          String
  colour         String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition   CustomFieldDefinition @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Cascade, map: "custom_field_options_definition_same_org_fk")

  @@unique([organizationId, id], name: "custom_field_option_tenant_key")
  @@unique([organizationId, definitionId, value])
  @@index([organizationId, definitionId, sortOrder])
  @@map("custom_field_options")
}

/// Tenant-defined lead statuses. `category` is what code branches on — never the name, which a
/// tenant may rename to anything (rule 4).
model LeadStatus {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  colour         String?
  category       LeadStatusCategory @default(open)
  sortOrder      Int                @default(0) @map("sort_order")
  isDefault      Boolean            @default(false) @map("is_default")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads             Lead[]
  statusHistoryFrom LeadStatusHistory[] @relation("lead_status_history_from")
  statusHistoryTo   LeadStatusHistory[] @relation("lead_status_history_to")

  @@unique([organizationId, id], name: "lead_status_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, category, sortOrder])
  @@map("lead_statuses")
}

/// Where leads come from. Cost model is recorded here so source reports can join spend to revenue
/// once campaigns exist (`FR-LEAD-7`).
model LeadSource {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// Free-form grouping chosen by the tenant (paid, organic, referral, offline…).
  type           String?
  costModel      String?   @map("cost_model")
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  touchpoints  LeadTouchpoint[]

  @@unique([organizationId, id], name: "lead_source_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("lead_sources")
}

/// Why a lead was lost. `requiresNote` is what turns "Lost — other" into something a manager can act on.
model LostReason {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int       @default(0) @map("sort_order")
  requiresNote   Boolean   @default(false) @map("requires_note")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, id], name: "lost_reason_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("lost_reasons")
}

model Tag {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  colour         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadTags     LeadTag[]

  @@unique([organizationId, id], name: "tag_tenant_key")
  @@unique([organizationId, name])
  @@map("tags")
}

model LeadTag {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_tags_lead_same_org_fk")
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade, map: "lead_tags_tag_same_org_fk")

  @@unique([organizationId, id], name: "lead_tag_tenant_key")
  @@unique([organizationId, leadId, tagId])
  @@index([organizationId, tagId])
  @@map("lead_tags")
}

model Pipeline {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  entityType     PipelineEntity @default(lead) @map("entity_type")
  isDefault      Boolean        @default(false) @map("is_default")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@unique([organizationId, id], name: "pipeline_tenant_key")
  @@unique([organizationId, entityType, name])
  @@index([organizationId, entityType, isActive])
  @@map("pipelines")
}

/// A stage a lead moves through. `isWon`/`isLost` are what code branches on; `requiredFields` lists
/// the field keys that must be filled before a lead may enter the stage — the mechanism that stops a
/// pipeline becoming a set of empty buckets.
model PipelineStage {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  pipelineId          String    @map("pipeline_id") @db.Uuid
  name                String
  colour              String?
  sortOrder           Int       @default(0) @map("sort_order")
  probability         Int?      @db.SmallInt
  isWon               Boolean   @default(false) @map("is_won")
  isLost              Boolean   @default(false) @map("is_lost")
  requiredFields      Json      @default("[]") @map("required_fields") @db.JsonB
  targetDurationHours Int?      @map("target_duration_hours")
  /// Reserved for the automation engine (Phase 6); no reader yet, and validated as an object so a
  /// later release does not have to migrate malformed rows.
  automationHooks     Json      @default("{}") @map("automation_hooks") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline         Pipeline           @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade, map: "pipeline_stages_pipeline_same_org_fk")
  leads            Lead[]
  stageHistoryFrom LeadStageHistory[] @relation("lead_stage_history_from")
  stageHistoryTo   LeadStageHistory[] @relation("lead_stage_history_to")

  @@unique([organizationId, id], name: "pipeline_stage_tenant_key")
  @@unique([organizationId, pipelineId, name])
  @@index([organizationId, pipelineId, sortOrder])
  @@map("pipeline_stages")
}

/// The lead. The entity the whole product exists to serve.
///
/// Columns whose referenced table arrives in a later step (customer, campaign, form, website, ad
/// entity, next-action task) are deliberately **absent** rather than present as unconstrained uuids:
/// a nullable id with no foreign key is a column nothing can trust. They arrive with their tables.
model Lead {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // ── Ownership ────────────────────────────────────────────────────────────
  branchId       String? @map("branch_id") @db.Uuid
  teamId         String? @map("team_id") @db.Uuid
  assignedUserId String? @map("assigned_user_id") @db.Uuid

  // ── Identity ─────────────────────────────────────────────────────────────
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  /// Maintained by the application rather than a generated column: Prisma sends every column it
  /// knows about, and would fight a generated one exactly as it fights a trigger-maintained
  /// `updated_at` (docs/database-design.md §16.10).
  fullName  String  @map("full_name")
  company   String?
  jobTitle  String? @map("job_title")

  // ── Contact ──────────────────────────────────────────────────────────────
  /// Normalized to E.164 on write. Duplicate detection and search both rely on this being canonical.
  phoneE164    String? @map("phone_e164")
  /// Exactly what the customer typed or the provider sent, kept for support conversations.
  phoneRaw     String? @map("phone_raw")
  whatsappE164 String? @map("whatsapp_e164")
  email        String?
  city         String?
  state        String?
  country      String? @db.Char(2)
  postalCode   String? @map("postal_code")
  timezone     String?

  // ── Attribution ──────────────────────────────────────────────────────────
  leadSourceId   String?        @map("lead_source_id") @db.Uuid
  landingPageUrl String?        @map("landing_page_url")
  /// source/medium/campaign/term/content/gclid/fbclid, as captured.
  utm            Json           @default("{}") @db.JsonB
  createdVia     LeadCreatedVia @default(manual) @map("created_via")

  // ── Position ─────────────────────────────────────────────────────────────
  statusId   String       @map("status_id") @db.Uuid
  pipelineId String       @map("pipeline_id") @db.Uuid
  stageId    String       @map("stage_id") @db.Uuid
  priority   LeadPriority @default(medium)
  score      Int          @default(0)
  scoreBand  String?      @map("score_band")
  valueMinor BigInt?      @map("value_minor")
  currency   String?      @db.Char(3)

  // ── Custom fields (ADR-0005) ─────────────────────────────────────────────
  customValues     Json                     @default("{}") @map("custom_values") @db.JsonB
  /// Concatenated searchable custom values, maintained on write and folded into `search_vector`.
  customSearchText String?                  @map("custom_search_text")
  /// Maintained by a database trigger, so a write from raw SQL or an import cannot forget it.
  /// Prisma has no tsvector type; it is never selected through the client.
  searchVector     Unsupported("tsvector")? @map("search_vector")

  // ── Engagement ───────────────────────────────────────────────────────────
  firstContactedAt DateTime? @map("first_contacted_at") @db.Timestamptz(6)
  lastContactedAt  DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  lastActivityAt   DateTime? @map("last_activity_at") @db.Timestamptz(6)
  /// Denormalized from tasks for the executive's Today view (Phase 3 writes it).
  nextActionAt     DateTime? @map("next_action_at") @db.Timestamptz(6)
  openTasksCount   Int       @default(0) @map("open_tasks_count")
  touchCount       Int       @default(0) @map("touch_count")

  // ── Outcome ──────────────────────────────────────────────────────────────
  convertedAt  DateTime? @map("converted_at") @db.Timestamptz(6)
  lostAt       DateTime? @map("lost_at") @db.Timestamptz(6)
  lostReasonId String?   @map("lost_reason_id") @db.Uuid
  lostNote     String?   @map("lost_note")

  // ── Consent (docs/security.md §8 — configurable, never assumed) ──────────
  consentWhatsapp Boolean @default(false) @map("consent_whatsapp")
  consentEmail    Boolean @default(false) @map("consent_email")
  consentCalls    Boolean @default(false) @map("consent_calls")

  /// Set when this lead was created despite matching an existing one (`create_and_link`).
  isDuplicateOfId String? @map("is_duplicate_of_id") @db.Uuid
  /// Set when this lead was absorbed by a merge. A merged lead is soft-deleted, not destroyed,
  /// which is what makes the merge reversible.
  mergedIntoId    String? @map("merged_into_id") @db.Uuid

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, map: "leads_branch_same_org_fk")
  team         Team?         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict, map: "leads_team_same_org_fk")
  /// Through Membership, not User: "assigned to someone in another tenant" is unrepresentable.
  assignee     Membership?   @relation("lead_assignee", fields: [organizationId, assignedUserId], references: [organizationId, userId], onDelete: Restrict, map: "leads_assignee_same_org_fk")
  status       LeadStatus    @relation(fields: [organizationId, statusId], references: [organizationId, id], onDelete: Restrict, map: "leads_status_same_org_fk")
  pipeline     Pipeline      @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Restrict, map: "leads_pipeline_same_org_fk")
  stage        PipelineStage @relation(fields: [organizationId, stageId], references: [organizationId, id], onDelete: Restrict, map: "leads_stage_same_org_fk")
  source       LeadSource?   @relation(fields: [organizationId, leadSourceId], references: [organizationId, id], onDelete: Restrict, map: "leads_source_same_org_fk")
  lostReason   LostReason?   @relation(fields: [organizationId, lostReasonId], references: [organizationId, id], onDelete: Restrict, map: "leads_lost_reason_same_org_fk")

  isDuplicateOf    Lead?  @relation("lead_duplicate_pointer", fields: [organizationId, isDuplicateOfId], references: [organizationId, id], onDelete: Restrict, map: "leads_duplicate_of_same_org_fk")
  duplicatesOfThis Lead[] @relation("lead_duplicate_pointer")
  mergedInto       Lead?  @relation("lead_merge_pointer", fields: [organizationId, mergedIntoId], references: [organizationId, id], onDelete: Restrict, map: "leads_merged_into_same_org_fk")
  mergedFromThis   Lead[] @relation("lead_merge_pointer")

  tags                 LeadTag[]
  touchpoints          LeadTouchpoint[]
  assignments          LeadAssignment[]
  statusHistory        LeadStatusHistory[]
  stageHistory         LeadStageHistory[]
  duplicateOf          LeadDuplicate[]     @relation("duplicate_of")
  duplicateCandidateOf LeadDuplicate[]     @relation("duplicate_candidate")
  mergesAsSurvivor     LeadMerge[]         @relation("merge_survivor")
  mergesAsAbsorbed     LeadMerge[]         @relation("merge_absorbed")
  scoreEvents          LeadScoreEvent[]

  @@unique([organizationId, id], name: "lead_tenant_key")
  /// The default list.
  @@index([organizationId, createdAt(sort: Desc)])
  /// The executive's Today view.
  @@index([organizationId, assignedUserId, nextActionAt])
  /// Kanban columns, one page per column.
  @@index([organizationId, stageId, updatedAt(sort: Desc)])
  @@index([organizationId, statusId])
  /// Duplicate detection and phone search.
  @@index([organizationId, phoneE164])
  @@index([organizationId, whatsappE164])
  @@index([organizationId, leadSourceId, createdAt])
  @@index([organizationId, score(sort: Desc)])
  /// Ageing and recycling.
  @@index([organizationId, lastActivityAt])
  /// The recycle bin.
  @@index([organizationId, deletedAt])
  @@map("leads")
}

/// The attribution spine (`FR-ATT-1`). **Never overwritten**: a second capture of the same person
/// appends a row, which is what makes "same phone from three channels ⇒ one lead, three touchpoints"
/// true rather than aspirational.
model LeadTouchpoint {
  id               String            @id @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  leadId           String            @map("lead_id") @db.Uuid
  /// 1-based, per lead. Makes "first touch" and "last touch" attribution a lookup, not a sort guess.
  sequence         Int
  occurredAt       DateTime          @map("occurred_at") @db.Timestamptz(6)
  channel          TouchpointChannel
  leadSourceId     String?           @map("lead_source_id") @db.Uuid
  landingPageUrl   String?           @map("landing_page_url")
  utm              Json              @default("{}") @db.JsonB
  sessionId        String?           @map("session_id")
  /// False for touchpoints that must not be counted against ad spend (a manual entry, an import).
  costAttributable Boolean           @default(false) @map("cost_attributable")
  metadata         Json              @default("{}") @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_touchpoints_lead_same_org_fk")
  source       LeadSource?  @relation(fields: [organizationId, leadSourceId], references: [organizationId, id], onDelete: Restrict, map: "lead_touchpoints_source_same_org_fk")

  @@unique([organizationId, id], name: "lead_touchpoint_tenant_key")
  @@unique([organizationId, leadId, sequence])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, channel, occurredAt])
  @@map("lead_touchpoints")
}

/// Assignment history (`FR-ASG-5`). Kept separate from the timeline because a manager asks
/// "who has had this lead" as a structured question, not as prose to read.
model LeadAssignment {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  fromUserId     String?  @map("from_user_id") @db.Uuid
  toUserId       String?  @map("to_user_id") @db.Uuid
  toTeamId       String?  @map("to_team_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  /// Why this assignment happened: manual, a rule's name, a fallback, a round-robin turn.
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_assignments_lead_same_org_fk")

  @@unique([organizationId, id], name: "lead_assignment_tenant_key")
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, toUserId, createdAt])
  @@map("lead_assignments")
}

/// Status transitions with the time spent in the previous status — the raw material for
/// "leads sit in Contacted for 9 days on average", which no amount of current-state querying can answer.
model LeadStatusHistory {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  fromStatusId    String?  @map("from_status_id") @db.Uuid
  toStatusId      String   @map("to_status_id") @db.Uuid
  changedById     String?  @map("changed_by_id") @db.Uuid
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_status_history_lead_same_org_fk")
  fromStatus   LeadStatus?  @relation("lead_status_history_from", fields: [organizationId, fromStatusId], references: [organizationId, id], onDelete: Restrict, map: "lead_status_history_from_same_org_fk")
  toStatus     LeadStatus   @relation("lead_status_history_to", fields: [organizationId, toStatusId], references: [organizationId, id], onDelete: Restrict, map: "lead_status_history_to_same_org_fk")

  @@unique([organizationId, id], name: "lead_status_history_tenant_key")
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, toStatusId, createdAt])
  @@map("lead_status_history")
}

model LeadStageHistory {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  fromStageId     String?  @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  changedById     String?  @map("changed_by_id") @db.Uuid
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead           @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_stage_history_lead_same_org_fk")
  fromStage    PipelineStage? @relation("lead_stage_history_from", fields: [organizationId, fromStageId], references: [organizationId, id], onDelete: Restrict, map: "lead_stage_history_from_same_org_fk")
  toStage      PipelineStage  @relation("lead_stage_history_to", fields: [organizationId, toStageId], references: [organizationId, id], onDelete: Restrict, map: "lead_stage_history_to_same_org_fk")

  @@unique([organizationId, id], name: "lead_stage_history_tenant_key")
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, toStageId, createdAt])
  @@map("lead_stage_history")
}

/// The append-only timeline (ADR-0009). Rule 6: anything a business owner would want to see on a
/// lead is written here, and a feature that skips it is unfinished.
///
/// **Partitioned monthly by `occurred_at`**, which forces two departures from this schema's usual
/// shape, both required by PostgreSQL rather than chosen:
///
///  * the primary key must contain the partition key, hence `@@id([id, occurredAt])`;
///  * a unique constraint must contain the partition key, so the idempotency key is
///    `(organization_id, source_event_id, occurred_at)` rather than the pair named in ADR-0009.
///    That still makes a retry a no-op **provided `occurred_at` comes from the event** and never from
///    `now()` — which is why `TimelineService` requires it as an argument.
///
/// Subject columns for customers, deals and conversations arrive with those tables; adding a column
/// to a partitioned table propagates to every partition, so there is nothing to retrofit.
model Activity {
  id             String             @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  leadId         String?            @map("lead_id") @db.Uuid
  /// A string from `ACTIVITY_TYPES` in `@leados/shared`, not a database enum: adding a type must not
  /// need a migration, and a row written by an older release must still read (`FR-TL-3`).
  type           String
  actorType      ActorType          @default(user) @map("actor_type")
  actorId        String?            @map("actor_id") @db.Uuid
  /// Denormalized so a timeline renders without joining a person who may since have left.
  actorLabel     String?            @map("actor_label")
  /// When it happened, not when it was recorded. The partition key, and the idempotency anchor.
  occurredAt     DateTime           @map("occurred_at") @db.Timestamptz(6)
  /// A snapshot of what was true then. Deliberately allowed to drift from current state.
  payload        Json               @default("{}") @db.JsonB
  visibility     ActivityVisibility @default(all)
  /// The domain event that produced this row, when there was one. Makes a job retry a no-op.
  sourceEventId  String?            @map("source_event_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([id, occurredAt])
  @@unique([organizationId, id, occurredAt], name: "activity_tenant_key")
  @@unique([organizationId, sourceEventId, occurredAt], name: "activity_idempotency_key")
  @@index([organizationId, leadId, occurredAt(sort: Desc)])
  @@index([organizationId, type, occurredAt(sort: Desc)])
  @@index([organizationId, actorId, occurredAt(sort: Desc)])
  @@map("activities")
}

// ═════════════════════════════════════════════════════════════════════════════
// PHASE 2, STEP 2 — DUPLICATES AND ASSIGNMENT
// ═════════════════════════════════════════════════════════════════════════════

/// How this organization decides two captures are the same person (`FR-DUP-1`).
///
/// `matchOn` is a list of field sets: `[["phoneE164"], ["email", "lastName"]]` means "same phone, OR
/// same email and surname". A list of sets rather than a single expression because that is how a
/// business describes it — "the phone, or the email plus the name" — and because each set can then be
/// indexed independently.
model DuplicateRule {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  /// Array of arrays of field names. Validated against the known matchable fields on write.
  matchOn        Json            @map("match_on") @db.JsonB
  /// How far back to look. A phone reused after three years is usually a different enquiry.
  lookbackDays   Int             @default(365) @map("lookback_days")
  action         DuplicateAction @default(attach_to_existing)
  /// Lower runs first. The first rule that matches decides.
  priority       Int             @default(0)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detections   LeadDuplicate[]

  @@unique([organizationId, id], name: "duplicate_rule_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, isActive, priority])
  @@map("duplicate_rules")
}

/// A detected pair, awaiting a human decision.
///
/// `leadId` is the **existing** lead and `duplicateLeadId` the newer one, so "show me this lead's
/// suspected duplicates" is one indexed lookup from either side.
model LeadDuplicate {
  id              String          @id @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  leadId          String          @map("lead_id") @db.Uuid
  duplicateLeadId String          @map("duplicate_lead_id") @db.Uuid
  ruleId          String?         @map("rule_id") @db.Uuid
  /// Which fields actually matched, and with what values — so a person can see *why*.
  matchFields     Json            @default("{}") @map("match_fields") @db.JsonB
  /// 0–100. Derived from how many and which fields matched, not from a model.
  confidence      Int             @default(100)
  status          DuplicateStatus @default(open)
  resolvedById    String?         @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead           @relation("duplicate_of", fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_duplicates_lead_same_org_fk")
  duplicateLead Lead           @relation("duplicate_candidate", fields: [organizationId, duplicateLeadId], references: [organizationId, id], onDelete: Cascade, map: "lead_duplicates_candidate_same_org_fk")
  rule          DuplicateRule? @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Restrict, map: "lead_duplicates_rule_same_org_fk")

  @@unique([organizationId, id], name: "lead_duplicate_tenant_key")
  /// One open pair per direction; re-detecting the same pair must not pile up rows.
  @@unique([organizationId, leadId, duplicateLeadId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, duplicateLeadId])
  @@map("lead_duplicates")
}

/// A merge, with everything needed to undo it (`FR-DUP-4`).
///
/// `snapshot` holds the merged lead's own column values *before* the merge, plus the ids of every
/// child row that was moved. That is what makes reversal possible without a second copy of the data:
/// undo puts the columns back and moves the listed children home.
model LeadMerge {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  survivingLeadId String    @map("surviving_lead_id") @db.Uuid
  mergedLeadId    String    @map("merged_lead_id") @db.Uuid
  /// Which side won each conflicting field, as chosen by the person merging.
  fieldChoices    Json      @default("{}") @map("field_choices") @db.JsonB
  snapshot        Json      @default("{}") @db.JsonB
  performedById   String?   @map("performed_by_id") @db.Uuid
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz(6)
  undoneById      String?   @map("undone_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survivingLead Lead         @relation("merge_survivor", fields: [organizationId, survivingLeadId], references: [organizationId, id], onDelete: Restrict, map: "lead_merges_survivor_same_org_fk")
  mergedLead    Lead         @relation("merge_absorbed", fields: [organizationId, mergedLeadId], references: [organizationId, id], onDelete: Restrict, map: "lead_merges_absorbed_same_org_fk")

  @@unique([organizationId, id], name: "lead_merge_tenant_key")
  /// A lead can only be absorbed once while the merge stands; the partial index in the migration
  /// allows a fresh merge after an undo.
  @@index([organizationId, mergedLeadId])
  @@index([organizationId, survivingLeadId, createdAt])
  @@map("lead_merges")
}

/// An ordered rule that decides who a new lead goes to (`FR-ASG-1`).
model AssignmentRule {
  id                  String             @id @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  name                String
  /// Lower runs first. The first rule whose conditions match is the one that assigns.
  priority            Int                @default(0)
  strategy            AssignmentStrategy
  /// Strategy-specific target: `{ userId }`, `{ teamId }`, `{ branchId }`. The pool for the
  /// round-robin strategies lives in `assignment_pool_members` instead, because it has per-member data.
  target              Json               @default("{}") @db.JsonB
  /// Skip anyone outside their working hours, on holiday, or on leave (`FR-ASG-4`).
  respectWorkingHours Boolean            @default(true) @map("respect_working_hours")
  /// Maximum open leads one person may hold under this rule. NULL means no cap.
  capacityCap         Int?               @map("capacity_cap")
  /// What happens when nobody is eligible: `{ mode: 'unassigned_pool' | 'user' | 'team', … }`.
  /// Never silent — the service raises a manager notification either way.
  fallback            Json               @default("{}") @db.JsonB
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conditions      AssignmentRuleCondition[]
  poolMembers     AssignmentPoolMember[]
  roundRobinState RoundRobinState?

  @@unique([organizationId, id], name: "assignment_rule_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, isActive, priority])
  @@map("assignment_rules")
}

/// One condition on a rule. AND within a `groupIndex`, OR across groups (`FR-ASG-2`) — which is
/// enough to express everything a business asks for without a nested expression tree.
model AssignmentRuleCondition {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  /// A lead column (`city`), a custom field (`custom.budget`) or a clock field (`time.hour`).
  fieldPath      String   @map("field_path")
  operator       String
  value          Json     @default("null") @db.JsonB
  groupIndex     Int      @default(0) @map("group_index")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AssignmentRule @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade, map: "assignment_rule_conditions_rule_same_org_fk")

  @@unique([organizationId, id], name: "assignment_rule_condition_tenant_key")
  @@index([organizationId, ruleId, groupIndex])
  @@map("assignment_rule_conditions")
}

/// Who is in a round-robin pool, and how heavily they are weighted.
model AssignmentPoolMember {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Weighted round-robin: a weight of 3 takes three turns to another's one.
  weight         Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AssignmentRule @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade, map: "assignment_pool_members_rule_same_org_fk")
  membership   Membership     @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "assignment_pool_members_membership_same_org_fk")

  @@unique([organizationId, id], name: "assignment_pool_member_tenant_key")
  @@unique([organizationId, ruleId, userId])
  @@index([organizationId, userId])
  @@map("assignment_pool_members")
}

/// Where a round-robin got to. **The durable truth**; Redis is only the fast path.
///
/// One row per rule, updated inside the assigning transaction, so two simultaneous captures cannot
/// both take the same turn — the row lock serialises them. A Redis counter alone would drift the
/// first time the cache was flushed, and "fairness" that resets on a deploy is not fairness.
model RoundRobinState {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  ruleId             String   @map("rule_id") @db.Uuid
  cursorIndex        Int      @default(0) @map("cursor_index")
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  /// Weighted round-robin: how many turns the current member has already taken.
  weightConsumed     Int      @default(0) @map("weight_consumed")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AssignmentRule @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade, map: "round_robin_state_rule_same_org_fk")

  @@unique([organizationId, id], name: "round_robin_state_tenant_key")
  @@unique([organizationId, ruleId])
  @@map("round_robin_state")
}

// ═══════════════════════════════════════════════════════════════════════════
// Scoring (FR-SCR-1..3)
// ═══════════════════════════════════════════════════════════════════════════

/// One additive or decay rule (`FR-SCR-1`).
///
/// `triggerEvent` names the domain event that makes the rule run, which is what keeps scoring out
/// of the write path: a lead is created, the event goes through the outbox, and the scoring queue
/// applies whatever rules that event triggers. A rule whose trigger no code path emits yet is
/// refused at configuration time rather than stored inert — see `SCORING_TRIGGERS`.
model ScoringRule {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// The domain event this rule reacts to, or `schedule.decay` for a decay rule.
  triggerEvent   String    @map("trigger_event")
  /// Flat AND-within-group / OR-across-groups conditions, the same shape assignment rules use.
  conditions     Json      @default("[]") @db.JsonB
  /// Points added when the rule applies. Negative is allowed: a bad signal costs points.
  points         Int       @default(0)
  /// How often this rule may apply to one lead. NULL means as often as its trigger fires.
  maxApplications Int?     @map("max_applications")
  /// `{ afterDays, points, everyDays, floor }` for a decay rule; NULL for an additive one.
  decay          Json?     @db.JsonB
  /// Lower runs first. Unlike assignment, **every** matching rule applies — this only orders them
  /// so the breakdown reads in the order a business listed them.
  priority       Int       @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoreEvents  LeadScoreEvent[]

  @@unique([organizationId, id], name: "scoring_rule_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, triggerEvent, isActive, priority])
  @@map("scoring_rules")
}

/// A named slice of the score range (`FR-SCR-3`).
///
/// Bands are validated as a **partition** of 0–1000: no overlaps, no gaps. An overlap would make a
/// lead's band depend on evaluation order, and a gap would leave a lead with a score and no band,
/// quietly excluding it from every band-filtered view the business relies on.
model ScoreBand {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  minScore       Int      @map("min_score")
  maxScore       Int      @map("max_score")
  colour         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id], name: "score_band_tenant_key")
  @@unique([organizationId, name])
  @@index([organizationId, minScore])
  @@map("score_bands")
}

/// Every point a lead's score is made of (`FR-SCR-2`).
///
/// **`leads.score` is a cache of `sum(delta)` over these rows.** That is what makes the breakdown a
/// manager reads identical to the arithmetic that produced the number, and recomputation a re-sum
/// rather than a re-derivation. `sourceEventId` carries the outbox event id, so a redelivery of the
/// same event scores once — enforced by a partial unique index rather than by application logic.
model LeadScoreEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  /// NULL for an adjustment that no rule produced (a recompute correction, a manual override).
  ruleId         String?  @map("rule_id") @db.Uuid
  delta          Int
  /// The rule's name at the time, or a sentence for an adjustment: this has to stay readable after
  /// the rule is renamed or deleted.
  reason         String
  /// The score after applying this delta, so the breakdown reads as a running balance.
  scoreAfter     Int      @map("score_after")
  /// The outbox event that caused this, when there was one.
  sourceEventId  String?  @map("source_event_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade, map: "lead_score_events_lead_same_org_fk")
  rule         ScoringRule? @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Restrict, map: "lead_score_events_rule_same_org_fk")

  @@unique([organizationId, id], name: "lead_score_event_tenant_key")
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, ruleId])
  @@map("lead_score_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// Saved views (FR-VIEW-3)
// ═══════════════════════════════════════════════════════════════════════════

/// A filter a business saved and named.
///
/// `filters` holds the DSL from `@leados/shared/filters`, validated before it is stored — a view
/// that fails at read time fails on somebody's dashboard while they are trying to work. Date
/// conditions may carry a *named window* (`{ window: 'today' }`) rather than a timestamp, which is
/// what stops "Today's Follow-ups" meaning last Tuesday forever.
model SavedView {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// NULL for a view the system provisioned, which nobody personally owns.
  ownerId        String?   @map("owner_id") @db.Uuid
  entityType     String    @map("entity_type")
  name           String
  /// `{ conditions: [{ field, operator, value, groupIndex }] }`.
  filters        Json      @default("{}") @db.JsonB
  /// Which columns the list shows, in order.
  columns        Json      @default("[]") @db.JsonB
  /// `{ field, direction }`.
  sort           Json      @default("{}") @db.JsonB
  visibility     String    @default("private")
  /// Required when `visibility` is `team`; ignored otherwise.
  teamId         String?   @map("team_id") @db.Uuid
  /// When set, this is the view members of that role land on.
  defaultForRoleId String? @map("default_for_role_id") @db.Uuid
  /// True for the views provisioning created, so "reset my views" can tell them apart.
  isSystem       Boolean   @default(false) @map("is_system")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Membership?  @relation(fields: [organizationId, ownerId], references: [organizationId, userId], onDelete: Cascade, map: "saved_views_owner_same_org_fk")
  team         Team?        @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict, map: "saved_views_team_same_org_fk")
  role         Role?        @relation(fields: [organizationId, defaultForRoleId], references: [organizationId, id], onDelete: Restrict, map: "saved_views_role_same_org_fk")

  @@unique([organizationId, id], name: "saved_view_tenant_key")
  @@index([organizationId, entityType, visibility])
  @@index([organizationId, ownerId, entityType])
  @@map("saved_views")
}
